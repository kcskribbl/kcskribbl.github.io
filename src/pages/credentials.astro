---
import BaseLayout from '../layouts/BaseLayout.astro';
import RecordCard from '../components/RecordCard.astro';
import {
  awards,
  certifications,
  contributions,
  credentials,
  reviews,
  talks,
} from '../data/site';

const sections = [
  {
    id: 'speaking',
    command: '$ ls ./speaking',
    title: 'Industry speaking',
    items: talks,
  },
  {
    id: 'contributions',
    command: '$ git log --contributions',
    title: 'Engineering, judging & community contributions',
    items: contributions,
  },
  {
    id: 'reviews',
    command: '$ cat ./reviews.json',
    title: 'Reviews & service',
    items: reviews,
  },
  {
    id: 'credentials',
    command: '$ ls ./credentials',
    title: 'Credentials',
    items: credentials,
  },
  {
    id: 'certifications',
    command: '$ ls ./certifications',
    title: 'Certifications',
    items: certifications,
  },
  {
    id: 'awards',
    command: '$ ls ./awards',
    title: 'Awards & recognition',
    items: awards,
  },
].filter((section) => section.items.length > 0);
---

<BaseLayout
  title="Industry Contributions & Service — Karthik Chandrasekaran"
  description="Industry talks, secure-systems engineering, innovation judging, technical peer review, and community contributions."
>
  <section class="page-hero section">
    <div class="container narrow">
      <p class="eyebrow">$ cat ./credentials/index.json</p>
      <h1>Technical judgment beyond the day job.<span class="cursor" aria-hidden="true"></span></h1>
      <p>
        I share practical engineering ideas, build open technical foundations, and
        evaluate emerging technology. These contributions complement my work leading
        engineering teams and building trustworthy systems.
      </p>
      <div class="record-nav" aria-label="Contribution sections">
        {sections.map((section) => <a href={`#${section.id}`}>{section.title}</a>)}
      </div>
    </div>
  </section>

  {
    sections.map((section, sectionIndex) => (
      <section class:list={['section', sectionIndex % 2 === 0 && 'section-tinted']} id={section.id}>
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">{section.command}</p>
            <h2>{section.title}</h2>
          </div>
          <div class="record-grid">
            {section.items.map((item) => <RecordCard item={item} />)}
          </div>
        </div>
      </section>
    ))
  }
</BaseLayout>
