---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  awards,
  certifications,
  contributions,
  credentials,
  reviews,
} from '../data/site';

const sections = [
  {
    id: 'certifications',
    command: '$ ls ./certifications',
    title: 'Certifications',
    items: certifications,
  },
  {
    id: 'credentials',
    command: '$ ls ./credentials',
    title: 'Credentials',
    items: credentials,
  },
  {
    id: 'contributions',
    command: '$ git log --contributions',
    title: 'Contributions',
    items: contributions,
  },
  {
    id: 'reviews',
    command: '$ cat ./reviews.json',
    title: 'Reviews & service',
    items: reviews,
  },
  {
    id: 'awards',
    command: '$ ls ./awards',
    title: 'Awards & recognition',
    items: awards,
  },
].filter((section) => section.items.length > 0);
---

<BaseLayout
  title="Credentials & Contributions — Karthik Chandrasekaran"
  description="Certifications, credentials, professional contributions, reviews, and awards."
>
  <section class="page-hero section">
    <div class="container narrow">
      <p class="eyebrow">$ cat ./credentials/index.json</p>
      <h1>A growing record of learning and contribution.<span class="cursor" aria-hidden="true"></span></h1>
      <p>
        Certifications, education, community contributions, professional service,
        and recognition collected in one place.
      </p>
    </div>
  </section>

  {
    sections.map((section, sectionIndex) => (
      <section class:list={['section', sectionIndex % 2 === 0 && 'section-tinted']} id={section.id}>
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">{section.command}</p>
            <h2>{section.title}</h2>
          </div>
          <div class="record-grid">
            {section.items.map((item) => (
              <article class="record-card">
                <p class="feature-meta">
                  {item.organization}{item.date ? ` · ${item.date}` : ''}
                </p>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                {item.url && (
                  <a href={item.url} target="_blank" rel="noreferrer">
                    View credential <span aria-hidden="true">↗</span>
                  </a>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>
    ))
  }
</BaseLayout>
