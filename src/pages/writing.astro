---
import BaseLayout from '../layouts/BaseLayout.astro';
import { blogs, publications, topics } from '../data/site';
---

<BaseLayout
  title="Writing & Research — Karthik Chandrasekaran"
  description="Writing and research on engineering leadership, AI systems, information retrieval, and cloud architecture."
>
  <section class="page-hero section">
    <div class="container narrow">
      <p class="eyebrow">$ cat ./writing/index.md</p>
      <h1>Notes from building teams, platforms, and intelligent systems.<span class="cursor" aria-hidden="true"></span></h1>
      <p>
        Practical ideas shaped by engineering leadership and a continuing interest in
        applied AI, information retrieval, and dependable software systems.
      </p>
      <div class="button-row">
        <a class="button button-primary" href="https://orcid.org/0009-0009-9411-4482" target="_blank" rel="noreferrer">
          $ open --orcid
        </a>
        <a class="button button-secondary" href="https://scholar.google.com/citations?user=VjCA5xUAAAAJ&hl=en" target="_blank" rel="noreferrer">
          $ open --scholar
        </a>
      </div>
    </div>
  </section>

  <section class="section section-tinted">
    <div class="container">
      {
        blogs.length > 0 && (
          <>
            <div class="section-heading">
              <p class="eyebrow">$ ls ./blogs</p>
              <h2>Latest essays</h2>
            </div>
            <div class="feature-list blog-list">
              {blogs.map((blog, index) => (
                <a class="feature-row" href={blog.url} target="_blank" rel="noreferrer">
                  <span class="feature-index">0{index + 1}</span>
                  <div>
                    <p class="feature-meta">Blog · {blog.date}</p>
                    <h2>{blog.title}</h2>
                    <p>{blog.description}</p>
                    {blog.tags.length > 0 && (
                      <div class="inline-tags">
                        {blog.tags.map((tag) => <span>#{tag}</span>)}
                      </div>
                    )}
                  </div>
                  <span class="feature-arrow" aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </>
        )
      }
      <div class="section-heading publications-heading">
        <p class="eyebrow">$ ls ./publications</p>
        <h2>Publications & research</h2>
      </div>
      <div class="feature-list">
        {publications.map((publication, index) => (
          <a class="feature-row" href={publication.url} target="_blank" rel="noreferrer">
            <span class="feature-index">0{index + 1}</span>
            <div>
              <p class="feature-meta">{publication.type} · {publication.date}</p>
              <h2>{publication.title}</h2>
              <p>{publication.description}</p>
            </div>
            <span class="feature-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">$ grep --topics ./writing</p>
      <div class="topic-cloud">
        {topics.map((topic) => <span>{topic}</span>)}
      </div>
      <div class="editorial-note">
        <h2>More essays are on the way.</h2>
        <p>
          This site is the home for future field notes, technical deep dives, and
          reflections on engineering management.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
