---
import BaseLayout from '../layouts/BaseLayout.astro';
import { focusAreas, profile, projects, publications, topics } from '../data/site';
---

<BaseLayout>
  <section class="hero section">
    <div class="container">
      <div class="terminal-window">
        <div class="terminal-bar" aria-hidden="true">
          <span class="terminal-dot dot-red"></span>
          <span class="terminal-dot dot-yellow"></span>
          <span class="terminal-dot dot-green"></span>
          <span class="terminal-title">karthik - zsh - 120x36</span>
        </div>
        <div class="hero-grid terminal-body">
          <div class="hero-copy">
            <p class="eyebrow"><span class="terminal-green">karthik@portfolio</span> ~ % whoami</p>
            <h1>I build teams and systems for the <em>next chapter.</em><span class="cursor" aria-hidden="true"></span></h1>
            <p class="hero-summary">{profile.summary}</p>
            <div class="button-row">
              <a class="button button-primary" href="#work">$ open ./work</a>
              <a class="button button-secondary" href={profile.links.linkedin} target="_blank" rel="noreferrer">
                $ connect --linkedin
              </a>
            </div>
          </div>
          <aside class="hero-card" aria-label="Professional profile">
            <p class="terminal-command">$ cat profile.json</p>
            <div class="profile-output">
              <p><span>"name"</span>: "{profile.name}",</p>
              <p><span>"role"</span>: "{profile.role}",</p>
              <p><span>"company"</span>: "{profile.company}",</p>
              <p><span>"location"</span>: "{profile.location}"</p>
            </div>
            <p class="terminal-status"><span>●</span> available for ideas</p>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <section class="signal-strip" aria-label="Areas of expertise">
    <div class="container signal-list">
      {topics.slice(0, 4).map((topic) => <span>{topic}</span>)}
    </div>
  </section>

  <section class="section" id="leadership">
    <div class="container">
      <div class="section-heading split-heading">
        <div>
          <p class="eyebrow">$ ls ./leadership</p>
          <h2>People, systems, and outcomes.</h2>
        </div>
        <p>
          The best engineering organizations pair technical depth with a clear mission,
          healthy operating rhythms, and room for people to do their best work.
        </p>
      </div>
      <div class="principles-grid">
        {focusAreas.map((area) => (
          <article class="principle-card">
            <span>{area.number}</span>
            <h3>{area.title}</h3>
            <p>{area.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-tinted" id="work">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">$ find ./writing -type featured</p>
        <h2>Ideas tested in the real world.</h2>
      </div>
      <div class="feature-list">
        {publications.map((publication, index) => (
          <a class="feature-row" href={publication.url} target="_blank" rel="noreferrer">
            <span class="feature-index">0{index + 1}</span>
            <div>
              <p class="feature-meta">{publication.type} · {publication.date}</p>
              <h3>{publication.title}</h3>
              <p>{publication.description}</p>
            </div>
            <span class="feature-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      <a class="text-link" href="/writing">View all writing and research <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading split-heading">
        <div>
          <p class="eyebrow">$ ls ./projects</p>
          <h2>Selected projects.</h2>
        </div>
        <p>Experiments and tools spanning backend systems, developer utilities, and the web.</p>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <a class="project-card" href={project.url} target="_blank" rel="noreferrer">
            <span class="project-language">{project.language}</span>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <span class="project-link">View on GitHub <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section closing">
    <div class="container closing-inner">
      <p class="eyebrow">$ ./connect.sh</p>
      <h2>Building organizations and technology that endure.<span class="cursor" aria-hidden="true"></span></h2>
      <p>
        I write about engineering leadership, applied AI, search systems, and lessons
        learned while scaling software and teams.
      </p>
      <div class="button-row">
        <a class="button button-light" href={profile.links.linkedin} target="_blank" rel="noreferrer">Connect on LinkedIn</a>
        <a class="button button-outline-light" href={profile.links.github} target="_blank" rel="noreferrer">Follow on GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>
