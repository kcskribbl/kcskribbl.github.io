---
import type { RecordItem } from '../data/site';

interface Props {
  item: RecordItem;
}

const { item } = Astro.props;
---

<article class="record-card">
  <p class="feature-meta">
    {item.type ? `${item.type} · ` : ''}{item.organization}{item.date ? ` · ${item.date}` : ''}
  </p>
  {item.status && <p class="record-status">{item.status}</p>}
  <h3>{item.title}</h3>
  {item.metric && <p class="record-metric">{item.metric}</p>}
  <p>{item.description}</p>
  {item.url && (
    <a href={item.url} target="_blank" rel="noreferrer">
      {item.linkLabel || 'View details'} <span aria-hidden="true">↗</span>
    </a>
  )}
</article>
